# Where the proxy forwards redacted requests: any OpenAI-compatible server (OpenAI, Ollama, vLLM, Crusoe, ...).
# Leave unset to use Crusoe below. Quote keys: they may contain $.
# PIIGUARD_UPSTREAM_URL=https://api.openai.com/v1
# PIIGUARD_UPSTREAM_KEY='...'
# PIIGUARD_MODEL_ALLOWLIST=gpt-4o-mini
# Crusoe Managed Inference (OpenAI-compatible). Also used by the red team, coach and --llm classifier.
CRUSOE_API_KEY='...'
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Models (confirm with: piiguard models)
WORKER_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B
COACH_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
FALLBACK_MODEL=deepseek-ai/Deepseek-V4-Flash
# You.com
YDC_API_KEY='...'
# Guard proxy
GUARD_PROXY_TOKEN=guard-dev-token
